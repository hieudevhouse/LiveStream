<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết Sản phẩm/Dịch vụ - Cao cấp</title>
    <!-- Use Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;600;700&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --primary: #15803d;
            /* Elegant Green */
            --primary-rgb: 21, 128, 61;
            --secondary: #0f172a;
            /* Slate Dark */
            --accent: #eab308;
            /* Yellow/Gold Accent */
            --bg-color: #f8fafc;
            --surface: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --radius-lg: 24px;
            --radius-md: 16px;
            --shadow-soft: 0 20px 40px rgba(0, 0, 0, 0.06);
            --shadow-hover: 0 30px 60px rgba(21, 128, 61, 0.15);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
        }

        h1,
        h2,
        h3,
        h4 {
            font-family: 'Outfit', sans-serif;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* Navbar Back Button */
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 600;
            margin-bottom: 30px;
            transition: color 0.3s ease;
        }

        .back-btn:hover {
            color: var(--primary);
        }

        /* Loader */
        #loader {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 60vh;
            font-size: 1.5rem;
            color: var(--primary);
            font-weight: 600;
            font-family: 'Outfit', sans-serif;
        }

        /* Main View */
        #mainContent {
            display: none;
        }

        .product-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            background: var(--surface);
            padding: 35px;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-soft);
        }

        /* Image Gallery */
        .gallery {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .main-image {
            width: 100%;
            height: 400px;
            border-radius: var(--radius-lg);
            overflow: hidden;
            position: relative;
            background: #f1f5f9;
        }

        .main-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .main-image:hover img {
            transform: scale(1.05);
        }

        .thumbnails {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .thumb {
            height: 80px;
            border-radius: var(--radius-md);
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }

        .thumb.active {
            border-color: var(--primary);
        }

        .thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Info Section */
        .product-info {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .tag-pill {
            display: inline-block;
            background: rgba(var(--primary-rgb), 0.1);
            color: var(--primary);
            padding: 6px 16px;
            border-radius: 99px;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 20px;
            align-self: flex-start;
        }

        .product-title {
            font-size: 2.2rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 16px;
            color: var(--secondary);
        }

        .brand-name {
            font-size: 1.1rem;
            color: var(--text-muted);
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-name i {
            color: var(--primary);
        }

        .price-box {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 25px;
            display: flex;
            align-items: baseline;
            gap: 8px;
        }

        .price-box span {
            font-size: 1.2rem;
            font-weight: 500;
            color: var(--text-muted);
        }

        .desc {
            font-size: 1.1rem;
            color: var(--text-muted);
            margin-bottom: 40px;
            line-height: 1.8;
        }

        /* Order Button */
        .btn-order {
            background: linear-gradient(135deg, #16a34a, #15803d);
            color: #fff;
            border: none;
            padding: 20px 40px;
            border-radius: var(--radius-md);
            font-size: 1.2rem;
            font-weight: 700;
            font-family: 'Outfit', sans-serif;
            cursor: pointer;
            transition: all 0.4s ease;
            box-shadow: 0 10px 20px rgba(21, 128, 61, 0.3);
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
        }

        .btn-order:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(21, 128, 61, 0.4);
        }

        /* Extra Details */
        .extra-details {
            margin-top: 50px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .detail-item {
            background: #f8fafc;
            padding: 20px;
            border-radius: var(--radius-md);
            border: 1px solid #e2e8f0;
        }

        .detail-item h4 {
            color: var(--secondary);
            font-size: 1rem;
            margin-bottom: 8px;
        }

        .detail-item p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        /* Modal (Popup) Glassmorphism */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 3000;
            display: flex;
            opacity: 0;
            visibility: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-content {
            background: rgba(255, 255, 255, 0.95);
            width: 100%;
            max-width: 420px;
            border-radius: var(--radius-md);
            padding: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            border: 1px solid rgba(255, 255, 255, 0.8);
            transform: translateY(20px) scale(0.95);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .modal-overlay.active .modal-content {
            transform: translateY(0) scale(1);
        }

        .close-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #f1f5f9;
            border: none;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            font-size: 1rem;
            cursor: pointer;
            color: var(--text-muted);
            transition: all 0.2s ease;
        }

        .close-btn:hover {
            background: #fee2e2;
            color: #ef4444;
        }

        .modal-header {
            margin-bottom: 15px;
            text-align: center;
        }

        .modal-header h3 {
            font-size: 1.25rem;
            color: var(--secondary);
            font-weight: 800;
        }

        .modal-header p {
            color: var(--text-muted);
            margin-top: 2px;
            font-size: 0.8rem;
        }

        .form-group {
            margin-bottom: 12px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--secondary);
            font-size: 0.85rem;
        }

        .form-control {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.9rem;
            background: #f8fafc;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(21, 128, 61, 0.1);
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .btn-submit {
            width: 100%;
            background: var(--primary);
            color: white;
            border: none;
            padding: 12px;
            font-size: 0.95rem;
            font-weight: 700;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 5px;
        }

        .btn-submit:hover {
            background: #166534;
            box-shadow: 0 10px 20px rgba(21, 128, 61, 0.2);
        }

        /* Responsive */
        @media (max-width: 900px) {
            .product-grid {
                grid-template-columns: 1fr;
            }

            .grid-2 {
                grid-template-columns: 1fr;
            }

            .main-image {
                height: 400px;
            }

            .extra-details {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="container">
        <a href="/products" class="back-btn">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
                </path>
            </svg>
            Trở về danh sách sản phẩm
        </a>

        <div id="loader">Đang tải thông tin sản phẩm...</div>

        <div id="mainContent">
            <div class="product-grid">
                <!-- Left: Gallery -->
                <div class="gallery">
                    <div class="main-image">
                        <img id="mainImg" src="" alt="Sản phẩm">
                    </div>
                    <div class="thumbnails" id="thumbnailsContainer">
                        <!-- Dynamic Thumbs here -->
                    </div>
                </div>

                <!-- Right: Info -->
                <div class="product-info">
                    <div class="tag-pill" id="categoryTag">Lĩnh vực</div>
                    <h1 class="product-title" id="productName">Tên Sản Phẩm</h1>

                    <div class="brand-name">
                        <img id="brandLogo" src="" alt="Logo"
                            style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; display: none; border: 1px solid #e2e8f0;">
                        <span id="brandName" style="font-weight: 600;">Tên nhãn hàng</span>
                    </div>

                    <div class="price-box">
                        <span id="priceValue">0</span><span>VND</span>
                    </div>

                    <p class="desc" id="productDesc">
                        Mô tả chi tiết sản phẩm.
                    </p>

                    <div class="certifications-section" id="certificationsSection"
                        style="display: none; margin-bottom: 30px;">
                        <h4
                            style="font-size: 1.1rem; color: var(--secondary); margin-bottom: 15px; display: flex; align-items: center; gap: 8px;">
                            <svg width="24" height="24" style="color:#ca8a04" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z">
                                </path>
                            </svg>
                            Chứng nhận & Giấy phép
                        </h4>
                        <div id="certificationsList" style="display: flex; flex-wrap: wrap; gap: 15px;">
                            <!-- Certificates go here -->
                        </div>
                    </div>

                    <div style="display: flex; gap: 15px;">
                        <button class="btn-order" onclick="openOrderModal(false)" style="flex: 1;">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
                                </path>
                            </svg>
                            ĐẶT NGAY
                        </button>
                        <button onclick="addToCart()"
                            style="background: #f8fafc; color: var(--secondary); border: 2px solid #e2e8f0; padding: 20px 30px; border-radius: var(--radius-md); font-weight: 700; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 10px;"
                            onmouseover="this.style.background='#e2e8f0'" onmouseout="this.style.background='#f8fafc'">
                            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
                                </path>
                            </svg>
                            THÊM GIỎ
                        </button>
                    </div>

                    <div class="extra-details">
                        <div class="detail-item">
                            <h4>Thông tin liên hệ</h4>
                            <div id="brandContact"
                                style="font-size: 0.95rem; color: var(--text-muted); line-height: 1.8;">
                                <!-- Injected by JS -->
                            </div>
                        </div>
                        <div class="detail-item">
                            <h4>Địa chỉ & Website</h4>
                            <div id="brandAddress"
                                style="font-size: 0.95rem; color: var(--text-muted); line-height: 1.8;">
                                <!-- Injected by JS -->
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- ORDER MODAL -->
    <div class="modal-overlay" id="orderModal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeOrderModal()">✕</button>
            <div class="modal-header">
                <h3>Xác nhận mua hàng</h3>
                <p>Vui lòng điền thông tin để chúng tôi liên hệ giao hàng</p>
            </div>

            <form id="orderForm" onsubmit="submitOrder(event)">
                <input type="hidden" id="orderProductId">
                <input type="hidden" id="orderPrice">

                <div class="form-group">
                    <label>Họ và Tên</label>
                    <input type="text" id="customerName" class="form-control" required
                        placeholder="Nhập họ tên của bạn">
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>Số Điện Thoại</label>
                        <input type="tel" id="customerPhone" class="form-control" required placeholder="09xxxxxxx">
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" id="customerEmail" class="form-control" required
                            placeholder="email@domain.com">
                    </div>
                </div>

                <div class="form-group">
                    <label>Địa chỉ Giao Hàng</label>
                    <input type="text" id="address" class="form-control" required
                        placeholder="Số nhà, đường, quận/huyện, tỉnh/thành phố">
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>Quận / Huyện</label>
                        <input type="text" id="district" class="form-control" required placeholder="Tên quận/huyện">
                    </div>
                    <div class="form-group" id="qtyGroup">
                        <label>Số lượng</label>
                        <input type="number" id="quantity" class="form-control" value="1" min="1" required
                            oninput="updateTotal()">
                    </div>
                </div>

                <div class="form-group"
                    style="margin-bottom: 12px; background: #f8fafc; padding: 12px; border-radius: 8px; border: 1px dashed #cbd5e1;">
                    <label>Mã Voucher (nếu có)</label>
                    <div style="display: flex; gap: 8px;">
                        <input type="text" id="voucherCode" class="form-control" placeholder="Mã giảm giá"
                            style="text-transform: uppercase;">
                        <button type="button" onclick="applyVoucher()"
                            style="background: var(--secondary); color: white; border: none; padding: 0 15px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; font-size: 0.85rem;">Áp
                            dụng</button>
                    </div>
                    <div id="voucherMessage" style="font-size: 0.8rem; margin-top: 6px; font-weight: 500;"></div>
                </div>

                <div
                    style="background: rgba(21,128,61,0.05); border: 1px solid rgba(21,128,61,0.1); border-radius: 8px; padding: 12px 15px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center;">
                    <span id="totalPaymentLabel"
                        style="font-weight: 600; color: var(--secondary); font-size: 0.95rem;">Tổng thanh toán:</span>
                    <span id="totalPaymentUI"
                        style="font-size: 1.4rem; font-weight: 800; color: var(--primary); text-align:right;">0 ₫</span>
                </div>

                <button type="submit" class="btn-submit">HOÀN TẤT ĐẶT HÀNG</button>
            </form>
        </div>
    </div>

    <div class="container" style="margin-top: 40px; padding-top: 40px; border-top: 1px solid #e2e8f0;">
        <h3 style="font-size: 2rem; color: var(--secondary); margin-bottom: 30px;">Sản phẩm cùng nhãn hàng</h3>
        <div id="relatedProductsGrid"
            style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
            <!-- Related Products will be injected here -->
        </div>
    </div>

    <!-- CART SIDEBAR -->
    <div id="cartDrawer"
        style="position: fixed; top: 0; right: -450px; width: 450px; height: 100vh; background: #fff; z-index: 2000; box-shadow: -10px 0 30px rgba(0,0,0,0.1); transition: right 0.4s ease; display: flex; flex-direction: column;">
        <div
            style="padding: 25px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.6rem; color: var(--secondary);">Giỏ hàng</h3>
            <button onclick="toggleCart()"
                style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted);">&times;</button>
        </div>
        <div id="cartItemsContainer"
            style="flex: 1; overflow-y: auto; padding: 25px; display: flex; flex-direction: column; gap: 20px;">
            <!-- Items -->
        </div>
        <div style="padding: 25px; border-top: 1px solid #e2e8f0; background: #f8fafc;">
            <div
                style="display: flex; justify-content: space-between; margin-bottom: 20px; font-weight: 700; font-size: 1.3rem;">
                <span>Tạm tính (<span id="cartCountTotal">0</span>):</span>
                <span id="cartTotalUI" style="color: var(--primary);">0 ₫</span>
            </div>
            <button onclick="openOrderModal(true)" class="btn-submit" style="width: 100%; margin: 0;">THANH TOÁN GIỎ
                HÀNG</button>
        </div>
    </div>

    <div id="cartOverlayDrawer" onclick="toggleCart()"
        style="position: fixed; inset: 0; background: rgba(15,23,42,0.4); backdrop-filter: blur(2px); z-index: 1999; display: none; opacity: 0; transition: opacity 0.4s;">
    </div>

    <button onclick="toggleCart()"
        style="position: fixed; bottom: 40px; right: 40px; width: 65px; height: 65px; border-radius: 50%; background: var(--secondary); color: #fff; border: none; box-shadow: 0 10px 25px rgba(15,23,42,0.4); z-index: 1500; cursor: pointer; display: flex; justify-content: center; align-items: center; transition: all 0.3s;"
        onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
        <span id="cartBadge"
            style="position: absolute; top: -5px; right: -5px; background: #ef4444; color: #fff; border-radius: 50%; width: 26px; height: 26px; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; font-weight: bold; border: 2px solid white;">0</span>
        <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
            </path>
        </svg>
    </button>

    <script>
        const productId = "<%= productId %>";
        const defaultImage = '/uploads/products-services/default-product.png';
        let productPrice = 0;

        async function fetchProductDetails() {
            try {
                const res = await fetch(`/api/products/${productId}`);
                const json = await res.json();

                if (json.success && json.data.product) {
                    renderProduct(json.data.product);
                    renderRelatedProducts(json.data.relatedProducts);
                } else {
                    document.getElementById('loader').innerText = "Không tìm thấy sản phẩm!";
                }
            } catch (err) {
                console.error("Lỗi:", err);
                document.getElementById('loader').innerText = "Lỗi khi tải thông tin sản phẩm.";
            }
        }

        function renderRelatedProducts(related) {
            const grid = document.getElementById('relatedProductsGrid');
            if (!related || related.length === 0) {
                grid.innerHTML = '<p style="color: var(--text-muted);">Không có sản phẩm nào khác từ nhãn hàng này.</p>';
                return;
            }

            grid.innerHTML = related.map(p => {
                const img = p.description?.images?.[0] || defaultImage;
                return `
                <div style="background: white; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-soft); transition: transform 0.3s ease; cursor: pointer; border: 1px solid #e2e8f0;" onclick="window.location.href='/products/${p._id}'" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                    <img src="${img}" alt="${p.name}" style="width: 100%; height: 200px; object-fit: cover;" onerror="this.src='${defaultImage}'">
                    <div style="padding: 20px;">
                        <h4 style="font-size: 1.1rem; color: var(--secondary); margin-bottom: 8px;">${p.name}</h4>
                        <p style="font-size: 0.9rem; color: var(--text-muted);">${p.businessField || 'Nông sản'}</p>
                    </div>
                </div>
            `;
            }).join('');
        }

        function renderProduct(product) {
            document.getElementById('loader').style.display = 'none';
            document.getElementById('mainContent').style.display = 'block';

            // Basic Info
            document.getElementById('productName').innerText = product.name;
            document.getElementById('categoryTag').innerText = product.businessField || 'Nông Sản Việt';
            document.getElementById('productDesc').innerText = product.description?.general || 'Đang cập nhật mô tả...';

            // Brand Info
            const brand = product.businessOwnerId;
            document.getElementById('brandName').innerText = brand?.businessName || 'Nhãn hàng xác minh';

            const email = brand?.contactRepresentative?.email || brand?.email || brand?.individualEmail || 'Chưa cập nhật email';
            const phone = brand?.contactRepresentative?.phone || brand?.phone || brand?.individualPhone || 'Chưa cập nhật SĐT';
            const website = brand?.website ? `<a href="${brand.website.startsWith('http') ? brand.website : 'https://' + brand.website}" target="_blank" style="color: var(--primary); text-decoration: none;">${brand.website}</a>` : 'Không có trang web';
            const address = brand?.address || brand?.individualAddress || 'Chưa cập nhật địa chỉ';

            document.getElementById('brandContact').innerHTML = `<strong style="color: var(--secondary)">Email:</strong> ${email}<br><strong style="color: var(--secondary)">Số điện thoại:</strong> ${phone}`;
            document.getElementById('brandAddress').innerHTML = `<strong style="color: var(--secondary)">Địa chỉ:</strong> ${address}<br><strong style="color: var(--secondary)">Website:</strong> ${website}`;

            const brandLogo = document.getElementById('brandLogo');
            const defaultLogo = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(brand?.businessName || 'B') + '&background=e2e8f0&color=64748b';
            brandLogo.src = brand?.logo ? (brand.logo.startsWith('http') || brand.logo.startsWith('/') ? brand.logo : '/' + brand.logo.replace(/\\/g, '/')) : defaultLogo;
            brandLogo.style.display = 'block';

            // Certifications
            const certSection = document.getElementById('certificationsSection');
            const certList = document.getElementById('certificationsList');
            certList.innerHTML = '';
            let hasCerts = false;

            const addCert = (name, url) => {
                if (!url) return;
                hasCerts = true;
                let displayUrl = url.replace(/\\/g, '/');
                if (!displayUrl.startsWith('http') && !displayUrl.startsWith('/')) displayUrl = '/' + displayUrl;

                const isImage = displayUrl.match(/\.(jpeg|jpg|gif|png|webp)$/i);
                const content = isImage
                    ? `<div style="text-align: center;"><img src="${displayUrl}" style="height: 70px; border-radius: 8px; border: 1px solid #e2e8f0; cursor: pointer; object-fit: contain; background: #fff; padding: 4px; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'" onclick="window.open('${displayUrl}')" title="${name}"><div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 5px;">${name}</div></div>`
                    : `<a href="${displayUrl}" target="_blank" style="display: flex; align-items: center; gap: 8px; padding: 12px 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; color: var(--primary); text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: background 0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='#f8fafc'"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg> ${name}</a>`;

                certList.innerHTML += content;
            };

            if (product.certifications && product.certifications.length > 0) {
                product.certifications.forEach(c => addCert(c.name || 'Chứng nhận', c.certificate));
            }
            if (product.product?.intellectualProperty?.certificate) {
                addCert('Sở hữu trí tuệ', product.product.intellectualProperty.certificate);
            }
            if (product.service?.operatingLicense) {
                addCert('Giấy phép hoạt động', product.service.operatingLicense);
            }
            if (product.description?.documents && product.description.documents.length > 0) {
                product.description.documents.forEach((docUrl, i) => addCert('Tài liệu ' + (i + 1), docUrl));
            }

            if (hasCerts) certSection.style.display = 'block';
            else certSection.style.display = 'none';

            // Price

            productPrice = product.pricing?.baseCost || product.booking?.totalPrice || 0;
            document.getElementById('priceValue').innerText = productPrice.toLocaleString('vi-VN');

            // Order Form Setup
            document.getElementById('orderProductId').value = product._id;
            document.getElementById('orderPrice').value = productPrice;
            document.getElementById('quantity').value = 1; // Reset quantity
            updateTotal(); // Calculate initial total

            // Images
            const images = product.description?.images || [];
            const mainImg = document.getElementById('mainImg');
            const thumbContainer = document.getElementById('thumbnailsContainer');

            if (images.length > 0) {
                mainImg.src = images[0];
                mainImg.onerror = () => { mainImg.src = defaultImage; };

                images.slice(0, 4).forEach((imgSrc, idx) => {
                    const thumb = document.createElement('div');
                    thumb.className = `thumb ${idx === 0 ? 'active' : ''}`;
                    thumb.innerHTML = `<img src="${imgSrc}" onerror="this.src='${defaultImage}'">`;

                    thumb.onclick = () => {
                        document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
                        thumb.classList.add('active');
                        mainImg.style.opacity = '0.5';
                        setTimeout(() => {
                            mainImg.src = imgSrc;
                            mainImg.style.opacity = '1';
                        }, 150);
                    };

                    thumbContainer.appendChild(thumb);
                });
            } else {
                mainImg.src = defaultImage;
            }
        }

        // State
        const modal = document.getElementById('orderModal');
        let currentDiscount = 0;
        let appliedVoucherCode = '';
        let isCartCheckout = false;
        let cart = JSON.parse(localStorage.getItem('tvad_cart') || '[]');

        function saveCart() {
            localStorage.setItem('tvad_cart', JSON.stringify(cart));
            renderCartUI();
        }

        function addToCart() {
            const existing = cart.find(i => i.productId === productId);
            if (existing) {
                existing.quantity += parseInt(document.getElementById('quantity').value) || 1;
            } else {
                cart.push({
                    productId: productId,
                    name: document.getElementById('productName').innerText,
                    price: productPrice,
                    image: document.getElementById('mainImg').src,
                    quantity: parseInt(document.getElementById('quantity').value) || 1
                });
            }
            saveCart();
            toggleCart();
        }

        function toggleCart() {
            const drawer = document.getElementById('cartDrawer');
            const overlay = document.getElementById('cartOverlayDrawer');
            if (drawer.style.right === '0px') {
                drawer.style.right = '-450px';
                overlay.style.opacity = '0';
                setTimeout(() => overlay.style.display = 'none', 400);
            } else {
                overlay.style.display = 'block';
                setTimeout(() => overlay.style.opacity = '1', 10);
                drawer.style.right = '0px';
                renderCartUI();
            }
        }

        function renderCartUI() {
            const totalItems = cart.reduce((acc, i) => acc + i.quantity, 0);
            document.getElementById('cartBadge').innerText = totalItems;
            document.getElementById('cartCountTotal').innerText = totalItems;

            const container = document.getElementById('cartItemsContainer');
            container.innerHTML = '';
            let total = 0;

            if (cart.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: var(--text-muted); margin-top: 50px;">Giỏ hàng trống</p>';
            }

            cart.forEach((item, index) => {
                total += item.price * item.quantity;
                container.innerHTML += `
                <div style="display: flex; gap: 15px; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px;">
                    <img src="${item.image}" style="width: 70px; height: 70px; object-fit: cover; border-radius: 8px;">
                    <div style="flex: 1;">
                        <h5 style="margin-bottom: 5px; font-size: 0.95rem; color: var(--secondary);">${item.name}</h5>
                        <div style="color: var(--primary); font-weight: bold; margin-bottom: 10px;">${item.price.toLocaleString('vi-VN')} ₫</div>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <button onclick="updateCartQty(${index}, -1)" style="border: 1px solid #e2e8f0; width: 28px; height: 28px; background: #fff; cursor: pointer; border-radius: 4px;">-</button>
                            <span style="font-size: 0.9rem; font-weight: 600;">${item.quantity}</span>
                            <button onclick="updateCartQty(${index}, 1)" style="border: 1px solid #e2e8f0; width: 28px; height: 28px; background: #fff; cursor: pointer; border-radius: 4px;">+</button>
                            <button onclick="removeFromCart(${index})" style="background: none; border: none; color: #ef4444; margin-left: auto; cursor: pointer; font-size: 0.85rem;"><svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path></svg></button>
                        </div>
                    </div>
                </div>
            `;
            });
            document.getElementById('cartTotalUI').innerText = total.toLocaleString('vi-VN') + ' ₫';
        }

        function updateCartQty(index, delta) {
            cart[index].quantity += delta;
            if (cart[index].quantity <= 0) cart.splice(index, 1);
            saveCart();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            saveCart();
        }

        function updateTotal() {
            let subtotal = 0;
            if (isCartCheckout) {
                subtotal = cart.reduce((acc, i) => acc + (i.price * i.quantity), 0);
            } else {
                const qty = parseInt(document.getElementById('quantity').value) || 1;
                subtotal = qty * productPrice;
            }

            let finalPrice = subtotal - currentDiscount;
            if (finalPrice < 0) finalPrice = 0;

            document.getElementById('totalPaymentUI').innerHTML = `
            ${currentDiscount > 0 ? `<strike style="font-size: 1.1rem; color: #94a3b8; display: block; text-align: right;">${subtotal.toLocaleString('vi-VN')} ₫</strike>` : ''}
            <div>${finalPrice.toLocaleString('vi-VN')} ₫</div>
        `;
        }

        async function applyVoucher() {
            const code = document.getElementById('voucherCode').value.trim();
            let subtotal = 0;
            if (isCartCheckout) {
                subtotal = cart.reduce((acc, i) => acc + (i.price * i.quantity), 0);
            } else {
                const qty = parseInt(document.getElementById('quantity').value) || 1;
                subtotal = qty * productPrice;
            }

            const msgEl = document.getElementById('voucherMessage');

            if (!code) {
                currentDiscount = 0;
                appliedVoucherCode = '';
                msgEl.innerText = '';
                updateTotal();
                return;
            }

            const email = document.getElementById('customerEmail').value.trim();
            try {
                const res = await fetch('/api/vouchers/validate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code, orderTotal: subtotal, productId, customerEmail: email })
                });
                const data = await res.json();

                if (data.success) {
                    currentDiscount = data.data.discount;
                    appliedVoucherCode = data.data.code;
                    msgEl.style.color = 'var(--primary)';
                    msgEl.innerText = `✔️ Đã giảm ${currentDiscount.toLocaleString('vi-VN')} ₫`;
                    updateTotal();
                } else {
                    currentDiscount = 0;
                    appliedVoucherCode = '';
                    msgEl.style.color = '#ef4444';
                    msgEl.innerText = '❌ ' + data.message;
                    updateTotal();
                }
            } catch (err) {
                console.error(err);
                msgEl.style.color = '#ef4444';
                msgEl.innerText = '❌ Lỗi hệ thống khi kiểm tra voucher.';
            }
        }

        function openOrderModal(fromCart = false) {
            isCartCheckout = fromCart;
            if (fromCart && cart.length === 0) {
                alert('Giỏ hàng của bạn đang trống!');
                return;
            }

            if (fromCart) {
                document.getElementById('qtyGroup').style.display = 'none';
                document.getElementById('totalPaymentLabel').innerText = 'Thanh toán toàn giỏ hàng:';
                toggleCart(); // Close drawer
            } else {
                document.getElementById('qtyGroup').style.display = 'block';
                document.getElementById('totalPaymentLabel').innerText = 'Tổng thanh toán:';
            }

            // Reset voucher
            document.getElementById('voucherCode').value = '';
            currentDiscount = 0;
            appliedVoucherCode = '';
            document.getElementById('voucherMessage').innerText = '';

            updateTotal();

            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeOrderModal() {
            modal.classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        // Close on click outside
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeOrderModal();
            }
        });

        // Form Submit
        async function submitOrder(e) {
            e.preventDefault();

            const commonPayload = {
                customerName: document.getElementById('customerName').value,
                customerEmail: document.getElementById('customerEmail').value,
                customerPhone: document.getElementById('customerPhone').value,
                address: document.getElementById('address').value,
                district: document.getElementById('district').value,
                city: 'Tỉnh/TP', // Default or can add a select field
                voucherCode: appliedVoucherCode || undefined
            };

            const postItems = isCartCheckout
                ? cart.map(i => ({ ...commonPayload, productId: i.productId, quantity: i.quantity }))
                : [{ ...commonPayload, productId: document.getElementById('orderProductId').value, quantity: parseInt(document.getElementById('quantity').value) || 1 }];

            try {
                const promises = postItems.map(item => fetch('/api/orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(item)
                }));

                const responses = await Promise.all(promises);
                const results = await Promise.all(responses.map(r => r.json()));

                const failures = results.filter(r => !r.success);

                if (failures.length === 0) {
                    alert('🎉 Đặt hàng thành công!');
                    closeOrderModal();
                    document.getElementById('orderForm').reset();
                    if (isCartCheckout) {
                        cart = [];
                        saveCart();
                    }
                } else {
                    alert('Có lỗi xảy ra với một số sản phẩm: ' + failures.map(f => f.message).join(', '));
                }
            } catch (err) {
                console.error('Error submitting order', err);
                alert('Có lỗi kết nối khi đặt hàng.');
            }
        }

        // Start
        window.addEventListener('DOMContentLoaded', () => {
            fetchProductDetails();
            renderCartUI();
        });

        fetchProductDetails();
    </script>
</body>

</html>