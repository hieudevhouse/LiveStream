        function renderRecentOrders() {
            const statusFilter = document.getElementById('recentStatusFilter').value;
            const searchTerm = document.getElementById('recentSearchInput').value.toLowerCase();

            let filtered = window.adminAllOrders;

            // Filter by status
            if (statusFilter) filtered = filtered.filter(o => o.status === statusFilter);

            // Filter by search term
            if (searchTerm) {
                filtered = filtered.filter(o => 
                    (o.customerName || '').toLowerCase().includes(searchTerm) || 
                    (o.customerPhone || '').includes(searchTerm) ||
                    (o.product?.name || '').toLowerCase().includes(searchTerm) ||
                    (o.gift?.name || '').toLowerCase().includes(searchTerm)
                );
            }

            // Sort by most recent
            filtered.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));

            const totalPages = Math.ceil(filtered.length / ORDERS_PER_PAGE);
            if (recentOrdersPage > totalPages) recentOrdersPage = totalPages || 1;

            const startIdx = (recentOrdersPage - 1) * ORDERS_PER_PAGE;
            const paginated = filtered.slice(startIdx, startIdx + ORDERS_PER_PAGE);

            const tbody = document.querySelector('#recentOrdersTable tbody');
            if (paginated.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding: 40px; color:#94a3b8;">Không tìm thấy kết quả phù hợp.</td></tr>';
                document.getElementById('recentOrdersPagination').innerHTML = '';
                return;
            }

            tbody.innerHTML = paginated.map(o => `
                <tr>
                    <td>
                        <div style="font-weight: 700;">${o.customerName}</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">${o.customerPhone}</div>
                    </td>
                    <td>
                        <div style="font-weight: 600; color: var(--secondary);">${o.isGift ? '🎁 ' + (o.gift?.name || 'Quà tặng') : (o.product?.name || '---')}</div>
                    </td>
                    <td style="font-weight: 800; color: var(--primary);">${o.finalPrice.toLocaleString()} ₫</td>
                    <td><span class="booth-pill bg-${o.status}">${translate(o.status)}</span></td>
                    <td style="color: var(--text-muted); font-size: 0.85rem;">${new Date(o.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })}</td>
                    <td>
                        <button class="action-btn" onclick="viewOrder('${o._id}')">👁️</button>
                    </td>
                </tr>
            `).join('');

            renderPagination('recentOrdersPagination', totalPages, recentOrdersPage, (p) => { recentOrdersPage = p; renderRecentOrders(); });
        }

