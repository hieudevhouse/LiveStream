                        </td>
                        <td><code style="font-weight: 800; background: #f0fdf4; padding: 4px 8px; border-radius: 6px; color: #16a34a;">${g.codes.join(', ')}</code></td>
                        <td style="font-size: 0.85rem; color: var(--text-muted);">${g.description || '---'}</td>
                        <td style="font-weight: 700; color: ${g.stock < 10 ? '#ef4444' : 'var(--text-main)'}">${g.stock} quà</td>
                        <td>
                            <button class="action-btn" onclick="openGiftModal('${g._id}')">✏️</button>
                            <button class="action-btn" onclick="delExpo('gifts', '${g._id}')">🗑️</button>
                        </td>
                    </tr>
                `).join('');
            }
        }

        function openGiftModal(id = null) {
            document.getElementById('giftForm').reset();
            if (id) {
                const g = window.allGiftsData.find(x => x._id === id);
                if (g) {
                    document.getElementById('giftModalTitle').innerText = 'Chỉnh sửa Quà tặng';
                    document.getElementById('giftId').value = g._id;
                    document.getElementById('giftCodes').value = g.codes.join(', ');
                    document.getElementById('giftName').value = g.name;
                    document.getElementById('giftDescription').value = g.description || '';
                    if (g.imageUrl) {
                        setGiftImage(g.imageUrl);
                    } else {
                        resetGiftUploadUI();
                    }
                    document.getElementById('giftStock').value = g.stock;
                }
            } else {
                document.getElementById('giftModalTitle').innerText = 'Thêm Quà tặng mới';
                document.getElementById('giftId').value = '';
                resetGiftUploadUI();
            }
            document.getElementById('giftOverlay').style.display = 'flex';
        }

        function closeGiftModal() {
            document.getElementById('giftOverlay').style.display = 'none';
        }

        // --- Drag & Drop Image Logic ---
        const giftDropZone = document.getElementById('giftDropZone');
        const giftFileInput = document.getElementById('giftFileInput');
        const giftImageUrlInput = document.getElementById('giftImageUrl');
        const giftPreviewContainer = document.getElementById('giftPreviewContainer');
        const giftPreviewImg = document.getElementById('giftPreviewImg');
        const giftUploadPrompt = document.getElementById('giftUploadPrompt');

        giftDropZone.addEventListener('click', () => giftFileInput.click());

        giftDropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            giftDropZone.style.borderColor = 'var(--primary)';
            giftDropZone.style.background = '#f0fdf4';
        });

        giftDropZone.addEventListener('dragleave', () => {
            giftDropZone.style.borderColor = '#cbd5e1';
            giftDropZone.style.background = '#f8fafc';
        });

        giftDropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            giftDropZone.style.borderColor = '#cbd5e1';
            giftDropZone.style.background = '#f8fafc';
            const files = e.dataTransfer.files;
            if (files.length) handleGiftUpload(files[0]);
        });

        giftFileInput.addEventListener('change', (e) => {
            if (e.target.files.length) handleGiftUpload(e.target.files[0]);
        });

        async function handleGiftUpload(file) {
            if (!file.type.startsWith('image/')) {
                closeGiftModal();
                return Swal.fire('Thông báo', 'Vui lòng chọn file hình ảnh!', 'warning');
            }

            const formData = new FormData();
            formData.append('file', file);

            giftUploadPrompt.innerHTML = '<p>🔄 Đang tải lên...</p>';

            try {
                const res = await fetch('/admin/api/upload', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}` },
                    body: formData
                });
                const result = await res.json();

                if (result.success) {
                    setGiftImage(result.url);
                    notify('Đã tải ảnh lên thành công!');
                } else {
                    closeGiftModal();
                    Swal.fire('Lỗi!', result.message, 'error');
                    resetGiftUploadUI();
                }
            } catch (err) {
                console.error(err);
                closeGiftModal();
                Swal.fire('Lỗi kết nối!', 'Không thể kết nối đến máy chủ khi upload.', 'error');
                resetGiftUploadUI();
            }
        }

        function setGiftImage(url) {
            giftImageUrlInput.value = url;
            giftPreviewImg.src = url;
            giftPreviewContainer.style.display = 'block';
            giftUploadPrompt.style.display = 'none';
        }

        function removeGiftImage(e) {
            e.stopPropagation();
            resetGiftUploadUI();
        }

        function resetGiftUploadUI() {
            giftImageUrlInput.value = '';
            giftPreviewImg.src = '';
            giftPreviewContainer.style.display = 'none';
            giftUploadPrompt.style.display = 'block';
            giftUploadPrompt.innerHTML = `
                <span style="font-size: 2rem;">📸</span>
                <p style="margin-top: 10px; font-size: 0.85rem; color: #64748b;">Kéo thả ảnh hoặc click để chọn</p>
            `;
        }

        document.getElementById('giftForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('giftId').value;
            const payload = {
                codes: document.getElementById('giftCodes').value,
                name: document.getElementById('giftName').value,
                description: document.getElementById('giftDescription').value,
                imageUrl: document.getElementById('giftImageUrl').value,
                stock: parseInt(document.getElementById('giftStock').value)
            };

            const method = id ? 'PUT' : 'POST';
            const url = id ? `/admin/api/gifts/${id}` : '/admin/api/gifts';
            const r = await fetchExpo(url, method, payload);
            if (r && r.success) {
                notify(id ? 'Đã cập nhật quà tặng!' : 'Đã thêm quà tặng mới!');
                closeGiftModal();
                loadExpoGifts();
            }
        });

        async function saveVoucher(e) {
            e.preventDefault();
            const id = document.getElementById('voucherId').value;
            const limit = document.getElementById('vLimit').value;
            const payload = {
                code: document.getElementById('vCode').value.toUpperCase(),
                name: document.getElementById('vName').value,
                discountType: document.getElementById('vType').value,
                discountValue: document.getElementById('vValue').value,
                minimumOrder: document.getElementById('vMin').value || 0
            };
            if (limit) payload.usageLimit = parseInt(limit);

            const method = id ? 'PUT' : 'POST';
            const url = id ? `/admin/api/vouchers/${id}` : '/admin/api/vouchers';
            const r = await fetchExpo(url, method, payload);
            if (r && r.success) {
                notify(id ? 'Voucher đã cập nhật!' : 'Voucher mới đã sẵn sàng!');
                closeModal('voucherOverlay');
                loadExpoVouchers();
            } else if (r && !r.success) {
                closeModal('voucherOverlay');
                Swal.fire('Lỗi hệ thống', r.message || 'Lỗi khi lưu voucher', 'error');
            }
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        function translate(s) {
            const m = { pending: 'Chờ chốt đơn', confirmed: 'Đã xác nhận', processing: 'Đang chuẩn bị', shipped: 'Đang giao', delivered: 'Đã bàn giao', cancelled: 'Đã hủy' };
            return m[s] || s;
        }

        document.getElementById('logoutBtn').addEventListener('click', () => { localStorage.removeItem('adminToken'); window.location.href = '/admin/login'; });

        fetchOwners(); // Preload owners
        loadData('overview');
    </script>
</body>

</html>