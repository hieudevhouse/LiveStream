    <script>
        const token = localStorage.getItem('adminToken');
        if (!token) window.location.href = '/admin/login';

        function parseAdmin(t) { try { return JSON.parse(atob(t.split('.')[1])); } catch (e) { return null; } }
        const user = parseAdmin(token);
        if (user) {
            document.getElementById('adminName').innerText = user.email.split('@')[0];
            document.getElementById('adminMailLabel').innerText = user.email;
            document.getElementById('avatarLetter').innerText = user.email[0].toUpperCase();
        }

        const menuLinks = document.querySelectorAll('.menu-link');
        const views = document.querySelectorAll('.view-section');

        menuLinks.forEach(link => {
            link.addEventListener('click', () => {
                const target = link.dataset.target;
                menuLinks.forEach(l => l.classList.remove('active'));
                link.classList.add('active');
                views.forEach(v => v.classList.remove('active'));
                document.getElementById(target + 'View').classList.add('active');
                loadData(target);
            });
        });

        async function fetchExpo(url, method = 'GET', body = null) {
            const opt = {
                method,
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
            };
            if (body) opt.body = JSON.stringify(body);
            try {
                const r = await fetch(url, opt);
                const d = await r.json();
                if (r.status === 401 || r.status === 403) { localStorage.removeItem('adminToken'); window.location.href = '/admin/login'; return null; }
                return d;
            } catch (err) { notify('Expo Alert: Lỗi kết nối hệ thống!', 'error'); return null; }
        }

        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        function notify(m, icon = 'success') {
            Toast.fire({
                icon: icon,
                title: m
            });
        }

        async function loadData(target) {
            if (target === 'overview') { loadStats(); loadAllTransactions(); }
            if (target === 'orders') loadAllTransactions();
            if (target === 'products') loadExpoCatalog();
            if (target === 'vouchers') loadExpoVouchers();
            if (target === 'gifts') loadExpoGifts();
        }

        let revenueChart = null;
        let statusChart = null;
        let topProductsChart = null;
        let ratioChart = null;

        async function loadStats() {
            const r = await fetchExpo('/admin/api/dashboard-stats');
            if (r && r.success) {
                document.getElementById('statOrders').innerText = r.data.orderCount.toLocaleString();
                document.getElementById('statProducts').innerText = r.data.productCount.toLocaleString();
                document.getElementById('statVouchers').innerText = r.data.voucherCount.toLocaleString();

                // Tính tổng doanh thu thực tế từ dữ liệu hôm nay
                const totalRevenue = (r.data.revenue || []).reduce((sum, h) => sum + h.total, 0);
                document.getElementById('statRevenue').innerText = totalRevenue.toLocaleString() + ' ₫';

                initCharts(r.data);
            }
        }

        function initCharts(data) {
            const { revenue, status, topProducts, ratio, topBuyers } = data;

            // --- Top Buyers List ---
            const buyersList = document.getElementById('topBuyersList');
            if (topBuyers && topBuyers.length > 0) {
                buyersList.innerHTML = topBuyers.map((b, i) => `
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: ${i === 0 ? '#fffbeb' : '#f8fafc'}; border-radius: 12px; border: 1px solid ${i === 0 ? '#fef3c7' : 'transparent'};">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 32px; height: 32px; background: ${i === 0 ? '#f59e0b' : '#64748b'}; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem;">
                                ${i + 1}
                            </div>
                            <div>
                                <div style="font-weight: 700; color: var(--text-main);">${b.name}</div>
                                <div style="font-size: 0.75rem; color: var(--text-muted);">${b._id}</div>
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-weight: 800; color: var(--primary);">${b.totalSpent.toLocaleString()} ₫</div>
