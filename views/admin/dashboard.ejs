<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trung tâm Điều hành Hội chợ Nông sản | Dreamax Expo</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --primary: #15803d;
            /* Forest Green */
            --primary-light: #22c55e;
            --accent: #f97316;
            /* Event Orange */
            --sidebar-bg: #1e293b;
            --main-bg: #fdfcf9;
            /* Off-white eggshell */
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --sidebar-width: 280px;
            --radius: 16px;
            --shadow: 0 10px 30px rgba(21, 128, 61, 0.05);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Lexend', sans-serif;
            background: var(--main-bg);
            color: var(--text-main);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar - Expo Concept */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            color: #f1f5f9;
            display: flex;
            flex-direction: column;
            border-right: 4px solid var(--primary);
        }

        .sidebar-brand {
            padding: 40px 24px;
            text-align: center;
        }

        .brand-box {
            background: white;
            color: var(--primary);
            padding: 12px;
            border-radius: var(--radius);
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            border-bottom: 4px solid var(--accent);
        }

        .brand-box sub {
            font-size: 0.6rem;
            font-family: 'Lexend', sans-serif;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .sidebar-menu {
            flex: 1;
            padding: 20px 16px;
            list-style: none;
        }

        .menu-item {
            margin-bottom: 12px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px 20px;
            border-radius: 12px;
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: 0.3s;
            cursor: pointer;
        }

        .menu-link:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
        }

        .menu-link.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 8px 16px rgba(21, 128, 61, 0.2);
        }

        .sidebar-footer {
            padding: 24px;
            background: rgba(0, 0, 0, 0.1);
        }

        .user-block {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--accent);
            border: 2px solid white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: white;
        }

        .btn-logout {
            width: 100%;
            padding: 10px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: transparent;
            color: #ef4444;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
            font-weight: 600;
        }

        .btn-logout:hover {
            background: #ef4444;
            color: white;
        }

        /* Main Hub */
        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background-image: radial-gradient(#15803d10 1px, transparent 1px);
            background-size: 20px 20px;
        }

        .top-nav {
            height: 80px;
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
        }

        .expo-info {
            border-left: 4px solid var(--accent);
            padding-left: 16px;
        }

        .expo-info h4 {
            font-size: 1.1rem;
            color: var(--secondary);
            font-weight: 800;
        }

        .expo-info p {
            font-size: 0.8rem;
            color: var(--accent);
            font-weight: 600;
            text-transform: uppercase;
        }

        .search-expo {
            position: relative;
            width: 350px;
        }

        .search-expo input {
            width: 100%;
            padding: 12px 16px 12px 40px;
            border-radius: 99px;
            border: 1px solid var(--border);
            background: white;
            outline: none;
        }

        .search-expo::before {
            content: '🔍';
            position: absolute;
            left: 14px;
            top: 12px;
            opacity: 0.5;
        }

        .content {
            padding: 40px;
            overflow-y: auto;
            flex: 1;
        }

        /* Expo Hub Cards */
        .hub-header {
            margin-bottom: 32px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .hub-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            color: var(--primary);
        }

        .status-overview {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-bottom: 40px;
        }

        .status-card {
            background: white;
            padding: 24px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            transition: 0.3s;
        }

        .status-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
        }

        .status-card .label {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-card .label::before {
            content: '';
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
        }

        .status-card .value {
            font-size: 2rem;
            font-weight: 800;
            color: var(--primary);
        }

        /* Table & Lists as Expo Booths */
        .expo-container {
            background: white;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .expo-header {
            padding: 24px 30px;
            background: #fafafa;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .expo-header h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
        }

        .expo-table {
            width: 100%;
            border-collapse: collapse;
        }

        .expo-table th {
            text-align: left;
            padding: 16px 30px;
            background: white;
            font-size: 0.75rem;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .expo-table td {
            padding: 20px 30px;
            border-bottom: 1px solid #f8f8f8;
            font-size: 0.9rem;
        }

        .expo-table tr:hover td {
            background: #fdfdfd;
        }

        .booth-pill {
            padding: 6px 12px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 0.7rem;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .bg-pending {
            background: #fff7ed;
            color: #ea580c;
            border: 1px solid #ffedd5;
        }

        .bg-confirmed {
            background: #f0fdf4;
            color: #16a34a;
            border: 1px solid #dcfce7;
        }

        .bg-shipped {
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #dbeafe;
        }

        .bg-cancelled {
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fee2e2;
        }

        .product-preview {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .product-img {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            object-fit: cover;
            border: 2px solid #f1f5f9;
        }

        .product-title {
            font-weight: 700;
            color: var(--secondary);
            font-size: 0.95rem;
        }

        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: white;
            cursor: pointer;
            transition: 0.2s;
        }

        .action-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
            transform: scale(1.1);
        }

        .btn-fair {
            padding: 12px 24px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 4px 12px rgba(21, 128, 61, 0.2);
        }

        .btn-fair:hover {
            background: var(--primary-light);
            transform: translateY(-2px);
        }

        /* Modals & Views */
        .view-section {
            display: none;
        }

        .view-section.active {
            display: block;
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .modal {
            background: white;
            border-radius: 20px;
            width: 450px;
            padding: 32px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            border: 2px solid var(--primary);
        }

        .toast-box {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 3000;
        }

        .toast {
            background: var(--primary);
            color: white;
            padding: 16px 24px;
            border-radius: 12px;
            font-weight: 700;
            box-shadow: 10px 10px 30px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from {
                transform: translateY(100%);
            }

            to {
                transform: translateY(0);
            }
        }

        select, .form-input {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            outline: none;
            border: 1px solid var(--border);
            background: #f8fafc;
            font-weight: 500;
            font-family: inherit;
        }

        .form-input:focus, select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.1);
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .modal-lg {
            width: 700px;
            max-width: 95%;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-header-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 16px;
        }

        .modal-header-nav h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--primary);
        }

        .close-btn {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #94a3b8;
        }
        .close-btn:hover { color: #ef4444; }

        /* Order Details Styles */
        .order-detail-card {
            background: #f8fafc;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
        }
        .order-detail-header {
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 12px;
            font-size: 0.9rem;
            text-transform: uppercase;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }
        .detail-row span:first-child { color: var(--text-muted); }
        .detail-row span:last-child { font-weight: 600; text-align: right; }
    </style>
</head>

<body>

    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-box">
                DREAMAX<sub>Expo 2026</sub>
            </div>
        </div>

        <ul class="sidebar-menu">
            <li class="menu-item"><a class="menu-link active" data-target="overview">🏛️ Sảnh Điều hành</a></li>
            <li class="menu-item"><a class="menu-link" data-target="orders">💳 Giao dịch Hội chợ</a></li>
            <li class="menu-item"><a class="menu-link" data-target="products">🧺 Danh mục Gian hàng</a></li>
            <li class="menu-item"><a class="menu-link" data-target="vouchers">🧧 Mã Ưu đãi Đặc biệt</a></li>
        </ul>

        <div class="sidebar-footer">
            <div class="user-block">
                <div class="user-avatar" id="avatarLetter">A</div>
                <div>
                    <div style="font-weight:700; font-size: 0.9rem;" id="adminMailLabel">Admin Expo</div>
                    <div style="font-size: 0.75rem; color: #94a3b8;">Ban Tổ Chức</div>
                </div>
            </div>
            <button class="btn-logout" id="logoutBtn">Kết thúc ca trực</button>
        </div>
    </aside>

    <main class="main">
        <nav class="top-nav">
            <div class="expo-info">
                <h4>Hội chợ Nông sản 2026</h4>
                <p>Trung tâm Triển lãm Thành phố</p>
            </div>

            <div class="search-expo">
                <input type="text" placeholder="Tìm gian hàng, sản phẩm, khách mời...">
            </div>

            <div style="display: flex; gap: 12px;">
                <button class="btn-fair" onclick="window.open('/products', '_blank')">🌐 Trang chủ Hội chợ</button>
            </div>
        </nav>

        <section class="content">

            <!-- OVERVIEW HUB -->
            <div id="overviewView" class="view-section active">
                <div class="hub-header">
                    <div>
                        <h2>Xin chào, <span id="adminName">Admin</span>!</h2>
                        <p style="color: var(--text-muted);">Chào mừng bạn trở lại Trung tâm Điều hành số Hội chợ Nông
                            sản.</p>
                    </div>
                </div>

                <div class="status-overview">
                    <div class="status-card">
                        <div class="label">Tổng giao dịch</div>
                        <div class="value" id="statOrders">0</div>
                    </div>
                    <div class="status-card">
                        <div class="label">Sản phẩm trưng bày</div>
                        <div class="value" id="statProducts">0</div>
                    </div>
                    <div class="status-card">
                        <div class="label">Doanh thu dự kiến</div>
                        <div class="value" id="statRevenue">0</div>
                    </div>
                    <div class="status-card">
                        <div class="label">Chiến dịch Ưu đãi</div>
                        <div class="value" id="statVouchers">0</div>
                    </div>
                </div>

                <div class="expo-container">
                    <div class="expo-header">
                        <h3>Các giao dịch vừa chốt tại quầy</h3>
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <select id="recentStatusFilter" onchange="filterRecentOrders()" style="padding: 8px 12px; font-size: 0.85rem; width: auto;">
                                <option value="">Tất cả trạng thái</option>
                                <option value="pending">Chờ chốt đơn</option>
                                <option value="confirmed">Đã xác nhận</option>
                                <option value="processing">Đang chuẩn bị</option>
                                <option value="shipped">Đang Vận chuyển</option>
                                <option value="delivered">Đã bàn giao</option>
                                <option value="cancelled">Đã hủy</option>
                            </select>
                            <button class="action-btn" onclick="loadAllTransactions()">🔄</button>
                        </div>
                    </div>
                    <table class="expo-table" id="recentOrdersTable">
                        <thead>
                            <tr>
                                <th>Khách tham quan</th>
                                <th>Tổng thanh toán</th>
                                <th>Trạng thái</th>
                                <th>Giờ chốt</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div id="recentOrdersPagination" style="padding: 16px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px;"></div>
                </div>
            </div>

            <!-- SALES VIEW -->
            <div id="ordersView" class="view-section">
                <div class="hub-header">
                    <div>
                        <h2>Sổ cái Giao dịch</h2>
                        <p style="color: var(--text-muted);">Quản lý toàn bộ lộ trình đơn hàng từ đặt cọc đến bàn giao.
                        </p>
                    </div>
                </div>
                <div class="expo-container">
                    <div class="expo-header">
                        <h3>Lịch sử toàn bộ lệnh</h3>
                        <div style="display: flex; gap: 12px; align-items: center;">
                            <select id="fullStatusFilter" onchange="filterFullOrders()" style="padding: 8px 12px; font-size: 0.85rem; width: auto;">
                                <option value="">Tất cả trạng thái</option>
                                <option value="pending">Chờ chốt đơn</option>
                                <option value="confirmed">Đã xác nhận</option>
                                <option value="processing">Đang chuẩn bị</option>
                                <option value="shipped">Đang vận chuyển</option>
                                <option value="delivered">Đã bàn giao</option>
                                <option value="cancelled">Đã hủy</option>
                            </select>
                            <button class="action-btn" onclick="loadAllTransactions()">🔄</button>
                        </div>
                    </div>
                    <table class="expo-table" id="fullOrdersTable">
                        <thead>
                            <tr>
                                <th>Lô hàng & Ngày</th>
                                <th>Chủ lô hàng</th>
                                <th>Chi tiết trưng bày</th>
                                <th>Giá trị</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div id="fullOrdersPagination" style="padding: 16px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px;"></div>
                </div>
            </div>

            <!-- CATALOG VIEW -->
            <div id="productsView" class="view-section">
                <div class="hub-header">
                    <div>
                        <h2>Danh mục Sản phẩm Trưng bày</h2>
                        <p style="color: var(--text-muted);">Thông tin chi tiết các mặt hàng nông nghiệp tại các gian
                            hàng.</p>
                    </div>
                    <div>
                        <button class="btn-fair" onclick="openProductModal()">+ Thêm Sản phẩm</button>
                    </div>
                </div>
                <div class="expo-container">
                    <table class="expo-table" id="productsTable">
                        <thead>
                            <tr>
                                <th>Đặc điểm trưng bày</th>
                                <th>Phân khu</th>
                                <th>Đơn giá</th>
                                <th>Ưu đãi kèm</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <!-- PROMO VIEW -->
            <div id="vouchersView" class="view-section">
                <div class="hub-header">
                    <div>
                        <h2>Thẻ Ưu đãi & Voucher</h2>
                        <p style="color: var(--text-muted);">Quản lý các chương trình tri ân dành cho khách tham quan
                            hội chợ.</p>
                    </div>
                    <div>
                        <button class="btn-fair" onclick="openVoucherModal()">+ Tạo Voucher mới</button>
                    </div>
                </div>
                <div class="expo-container">
                    <table class="expo-table" id="vouchersTable">
                        <thead>
                            <tr>
                                <th>Mã số thẻ</th>
                                <th>Tên chương trình</th>
                                <th>Mức tri ân</th>
                                <th>Hiệu lực</th>
                                <th>Lượt tham gia</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

        </section>
    </main>

    <!-- STATUS TRANSITION MODAL -->
    <div class="overlay" id="statusOverlay">
        <div class="modal">
            <h3 style="margin-bottom: 24px; font-family: 'Playfair Display', serif; font-size: 1.5rem;">Cập nhật lộ
                trình giao hàng</h3>
            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 8px;">CHỌN TRẠNG THÁI
                    TIẾP THEO</label>
                <select id="statusSelect">
                    <option value="pending">⏳ Chờ chốt đơn</option>
                    <option value="confirmed">✅ Ban tổ chức xác nhận</option>
                    <option value="processing">🚜 Đang chuẩn bị lô hàng</option>
                    <option value="shipped">🚚 Đang vận chuyển expo</option>
                    <option value="delivered">🏁 Đã bàn giao xong</option>
                    <option value="cancelled">❌ Hủy bỏ giao dịch</option>
                </select>
            </div>
            <div style="display: flex; gap: 12px;">
                <button onclick="closeStatusModal()"
                    style="flex: 1; padding: 14px; border: none; background: #f1f5f9; border-radius: 12px; font-weight: 700; cursor: pointer;">Hủy
                    bỏ</button>
                <button onclick="updateStatus()"
                    style="flex: 1; padding: 14px; border: none; background: var(--primary); color: white; border-radius: 12px; font-weight: 700; cursor: pointer;">Chấp
                    thuận</button>
            </div>
        </div>
    </div>

    <div class="toast-box" id="toastContainer"></div>

    <!-- PRODUCT MODAL -->
    <div class="overlay" id="productOverlay">
        <div class="modal modal-lg">
            <div class="modal-header-nav">
                <h3 id="productModalTitle">Cập nhật Sản phẩm</h3>
                <button class="close-btn" onclick="closeModal('productOverlay')">×</button>
            </div>
            <form id="productForm" onsubmit="saveProduct(event)">
                <input type="hidden" id="productId">
                <div class="form-row">
                    <div class="form-group">
                        <label>Tên sản phẩm/Dịch vụ</label>
                        <input type="text" class="form-input" id="pName" required>
                    </div>
                    <div class="form-group">
                        <label>Gian hàng (Business Owner)</label>
                        <select id="pOwner" required>
                            <option value="">-- Chọn doanh nghiệp --</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Loại hình</label>
                        <select id="pType" required>
                            <option value="product">Sản phẩm vật lý</option>
                            <option value="service">Dịch vụ</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Lĩnh vực</label>
                        <input type="text" class="form-input" id="pField" required placeholder="VD: Nông sản sạch">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Giá niêm yết (VND)</label>
                        <input type="number" class="form-input" id="pPrice" required min="0">
                    </div>
                    <div class="form-group">
                        <label>Tồn kho hiện tại</label>
                        <input type="number" class="form-input" id="pStock" min="0" placeholder="Để trống nếu không giới hạn">
                    </div>
                </div>
                <div class="form-group">
                    <label>Mô tả ngắn</label>
                    <textarea class="form-input" id="pDesc" rows="3" placeholder="Thông tin nổi bật của sản phẩm"></textarea>
                </div>
                <div class="form-group">
                    <label>URL Hình ảnh (Link ảnh)</label>
                    <input type="url" class="form-input" id="pImg" placeholder="https://...">
                </div>
                <div style="display: flex; gap: 12px; margin-top: 24px;">
                    <button type="button" onclick="closeModal('productOverlay')" style="flex: 1; padding: 14px; border: none; background: #f1f5f9; border-radius: 12px; font-weight: 700; cursor: pointer;">Hủy</button>
                    <button type="submit" style="flex: 1; padding: 14px; border: none; background: var(--primary); color: white; border-radius: 12px; font-weight: 700; cursor: pointer;">Lưu thông tin</button>
                </div>
            </form>
        </div>
    </div>

    <!-- VOUCHER MODAL -->
    <div class="overlay" id="voucherOverlay">
        <div class="modal">
            <div class="modal-header-nav">
                <h3 id="voucherModalTitle">Tạo Thẻ Ưu Đãi</h3>
                <button class="close-btn" onclick="closeModal('voucherOverlay')">×</button>
            </div>
            <form id="voucherForm" onsubmit="saveVoucher(event)">
                <input type="hidden" id="voucherId">
                <div class="form-group">
                    <label>Mã Voucher (Code)</label>
                    <input type="text" class="form-input" id="vCode" style="text-transform: uppercase;" required placeholder="VD: EXPO2026">
                </div>
                <div class="form-group">
                    <label>Tên chương trình</label>
                    <input type="text" class="form-input" id="vName" required placeholder="Giảm giá khai mạc">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Loại Giảm</label>
                        <select id="vType">
                            <option value="fixed">Giảm Trực Tiếp (VND)</option>
                            <option value="percentage">Giảm Phần Trăm (%)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Mức Giảm</label>
                        <input type="number" class="form-input" id="vValue" required min="1">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Đơn tối thiểu</label>
                        <input type="number" class="form-input" id="vMin" value="0">
                    </div>
                    <div class="form-group">
                        <label>Giới hạn xài</label>
                        <input type="number" class="form-input" id="vLimit" placeholder="Để trống = vô hạn">
                    </div>
                </div>
                <div style="display: flex; gap: 12px; margin-top: 24px;">
                    <button type="button" onclick="closeModal('voucherOverlay')" style="flex: 1; padding: 14px; border: none; background: #f1f5f9; border-radius: 12px; font-weight: 700; cursor: pointer;">Hủy</button>
                    <button type="submit" style="flex: 1; padding: 14px; border: none; background: var(--primary); color: white; border-radius: 12px; font-weight: 700; cursor: pointer;">Lưu lưu đãi</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ORDER DETAIL MODAL -->
    <div class="overlay" id="orderDetailOverlay">
        <div class="modal modal-lg">
            <div class="modal-header-nav">
                <h3>Chi tiết Giao dịch: <span id="dtOrderNo" style="color:var(--text-main)">...</span></h3>
                <button class="close-btn" onclick="closeModal('orderDetailOverlay')">×</button>
            </div>
            
            <div class="form-row">
                <!-- Cột trái: Khách hàng & Giao hàng -->
                <div>
                    <div class="order-detail-card">
                        <div class="order-detail-header">👤 Khách hàng</div>
                        <div class="detail-row"><span>Tên:</span><span id="dtCustName">-</span></div>
                        <div class="detail-row"><span>SĐT:</span><span id="dtCustPhone">-</span></div>
                        <div class="detail-row"><span>Email:</span><span id="dtCustEmail">-</span></div>
                    </div>
                    <div class="order-detail-card">
                        <div class="order-detail-header">📍 Giao hàng</div>
                        <div class="detail-row"><span>Địa chỉ:</span><span id="dtAddress">-</span></div>
                        <div class="detail-row"><span>Khu vực:</span><span id="dtRegion">-</span></div>
                        <div class="detail-row"><span>Ghi chú:</span><span id="dtNotes">-</span></div>
                    </div>
                </div>

                <!-- Cột phải: Đơn hàng & Thanh toán -->
                <div>
                    <div class="order-detail-card">
                        <div class="order-detail-header">📦 Sản phẩm</div>
                        <div class="detail-row"><span>Mặt hàng:</span><span id="dtProduct" style="color:var(--primary)">-</span></div>
                        <div class="detail-row"><span>Gian hàng:</span><span id="dtOwner">-</span></div>
                        <div class="detail-row"><span>Số lượng:</span><span id="dtQty">-</span></div>
                        <div class="detail-row"><span>Đơn giá:</span><span id="dtPrice">-</span></div>
                    </div>
                    <div class="order-detail-card" style="background:#f0fdf4; border: 1px solid #dcfce7;">
                        <div class="order-detail-header">💰 Thanh toán</div>
                        <div class="detail-row"><span>Tạm tính:</span><span id="dtTotal">-</span></div>
                        <div class="detail-row"><span>Mã giảm (<span id="dtVoucherCode">none</span>):</span><span id="dtDiscount" style="color:var(--accent)">-</span></div>
                        <div class="detail-row" style="margin-top:10px; padding-top:10px; border-top:1px solid #dcfce7;">
                            <span style="font-weight:800; color:var(--text-main)">THỰC THU:</span>
                            <span id="dtFinal" style="font-size:1.2rem; font-weight:800; color:var(--primary)">-</span>
                        </div>
                    </div>
                </div>
            </div>

            <div style="margin-top:20px; text-align:right;">
                <button type="button" onclick="closeModal('orderDetailOverlay')" style="padding: 12px 24px; border: none; background: #e2e8f0; color:#475569; border-radius: 12px; font-weight: 700; cursor: pointer; margin-right:10px;">Đóng</button>
                <button type="button" onclick="openMod(currOrderObj._id, currOrderObj.status)" style="padding: 12px 24px; border: none; background: var(--primary); color: white; border-radius: 12px; font-weight: 700; cursor: pointer;">Cập nhật Lộ trình</button>
            </div>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('adminToken');
        if (!token) window.location.href = '/admin/login';

        function parseAdmin(t) { try { return JSON.parse(atob(t.split('.')[1])); } catch (e) { return null; } }
        const user = parseAdmin(token);
        if (user) {
            document.getElementById('adminName').innerText = user.email.split('@')[0];
            document.getElementById('adminMailLabel').innerText = user.email;
            document.getElementById('avatarLetter').innerText = user.email[0].toUpperCase();
        }

        const menuLinks = document.querySelectorAll('.menu-link');
        const views = document.querySelectorAll('.view-section');

        menuLinks.forEach(link => {
            link.addEventListener('click', () => {
                const target = link.dataset.target;
                menuLinks.forEach(l => l.classList.remove('active'));
                link.classList.add('active');
                views.forEach(v => v.classList.remove('active'));
                document.getElementById(target + 'View').classList.add('active');
                loadData(target);
            });
        });

        async function fetchExpo(url, method = 'GET', body = null) {
            const opt = {
                method,
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
            };
            if (body) opt.body = JSON.stringify(body);
            try {
                const r = await fetch(url, opt);
                const d = await r.json();
                if (r.status === 401 || r.status === 403) { localStorage.removeItem('adminToken'); window.location.href = '/admin/login'; return null; }
                return d;
            } catch (err) { notify('Expo Alert: Lỗi kết nối hệ thống!'); return null; }
        }

        function notify(m) {
            const t = document.createElement('div');
            t.className = 'toast';
            t.innerHTML = `🎋 ${m}`;
            document.getElementById('toastContainer').appendChild(t);
            setTimeout(() => t.remove(), 4000);
        }

        async function loadData(target) {
            if (target === 'overview') { loadStats(); loadAllTransactions(); }
            if (target === 'orders') loadAllTransactions();
            if (target === 'products') loadExpoCatalog();
            if (target === 'vouchers') loadExpoVouchers();
        }

        async function loadStats() {
            const r = await fetchExpo('/admin/api/stats');
            if (r && r.success) {
                document.getElementById('statOrders').innerText = r.data.orderCount.toLocaleString();
                document.getElementById('statProducts').innerText = r.data.productCount.toLocaleString();
                document.getElementById('statVouchers').innerText = r.data.voucherCount.toLocaleString();
                document.getElementById('statRevenue').innerText = (r.data.orderCount * 520000).toLocaleString() + ' ₫';
            }
        }

        // --- Orders Management ---
        window.adminAllOrders = [];
        let recentOrdersPage = 1;
        let fullOrdersPage = 1;
        const ORDERS_PER_PAGE = 10;

        async function loadAllTransactions() {
            const r = await fetchExpo('/admin/api/orders');
            if (r && r.success) {
                window.adminAllOrders = r.data;
                renderRecentOrders();
                renderFullOrders();
            }
        }

        function filterRecentOrders() {
            recentOrdersPage = 1;
            renderRecentOrders();
        }

        function filterFullOrders() {
            fullOrdersPage = 1;
            renderFullOrders();
        }

        function renderRecentOrders() {
            const statusFilter = document.getElementById('recentStatusFilter').value;
            let filtered = window.adminAllOrders;
            if (statusFilter) filtered = filtered.filter(o => o.status === statusFilter);

            const totalPages = Math.ceil(filtered.length / ORDERS_PER_PAGE);
            if (recentOrdersPage > totalPages) recentOrdersPage = totalPages || 1;

            const startIdx = (recentOrdersPage - 1) * ORDERS_PER_PAGE;
            const paginated = filtered.slice(startIdx, startIdx + ORDERS_PER_PAGE);

            const tbody = document.querySelector('#recentOrdersTable tbody');
            tbody.innerHTML = paginated.map(o => `
                <tr>
                    <td style="font-weight: 700;">${o.customerName}</td>
                    <td style="font-weight: 800; color: var(--primary);">${o.finalPrice.toLocaleString()} ₫</td>
                    <td><span class="booth-pill bg-${o.status}">${translate(o.status)}</span></td>
                    <td style="color: var(--text-muted);">${new Date(o.createdAt).toLocaleTimeString('vi-VN')}</td>
                    <td>
                        <button class="action-btn" onclick="viewOrder('${o._id}')">👁️</button>
                    </td>
                </tr>
            `).join('');

            renderPagination('recentOrdersPagination', totalPages, recentOrdersPage, (p) => { recentOrdersPage = p; renderRecentOrders(); });
        }

        function renderFullOrders() {
            const statusFilter = document.getElementById('fullStatusFilter').value;
            let filtered = window.adminAllOrders;
            if (statusFilter) filtered = filtered.filter(o => o.status === statusFilter);

            const totalPages = Math.ceil(filtered.length / ORDERS_PER_PAGE);
            if (fullOrdersPage > totalPages) fullOrdersPage = totalPages || 1;

            const startIdx = (fullOrdersPage - 1) * ORDERS_PER_PAGE;
            const paginated = filtered.slice(startIdx, startIdx + ORDERS_PER_PAGE);

            const tbody = document.querySelector('#fullOrdersTable tbody');
            tbody.innerHTML = paginated.map(o => `
                <tr>
                    <td>
                        <div style="font-weight: 800;">${o.orderNumber || 'EXPO-' + o._id.slice(-6).toUpperCase()}</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">${new Date(o.createdAt).toLocaleDateString('vi-VN')}</div>
                    </td>
                    <td>
                        <div style="font-weight: 700;">${o.customerName}</div>
                        <div style="font-size: 0.8rem; color: var(--secondary);">${o.customerPhone}</div>
                    </td>
                    <td>
                        <div style="font-weight: 600;">${o.product?.name || '---'}</div>
                        <div style="font-size: 0.7rem; color: var(--accent);">Mã Thẻ: ${o.voucherCode || 'Không'}</div>
                    </td>
                    <td><div style="font-weight: 800; color: var(--primary);">${o.finalPrice.toLocaleString()} ₫</div></td>
                    <td><span class="booth-pill bg-${o.status}">${translate(o.status)}</span></td>
                    <td>
                        <button class="action-btn" onclick="viewOrder('${o._id}')">👁️</button>
                        <button class="action-btn" onclick="openMod('${o._id}', '${o.status}')">✏️</button>
                    </td>
                </tr>
            `).join('');

            renderPagination('fullOrdersPagination', totalPages, fullOrdersPage, (p) => { fullOrdersPage = p; renderFullOrders(); });
        }

        function renderPagination(containerId, totalPages, currentPage, onPageChange) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            if (totalPages <= 1) return;

            const prevNode = document.createElement('button');
            prevNode.innerText = '❮';
            prevNode.className = 'action-btn';
            prevNode.disabled = currentPage === 1;
            prevNode.style.fontWeight = '700';
            prevNode.onclick = () => onPageChange(currentPage - 1);
            container.appendChild(prevNode);

            const infoNode = document.createElement('span');
            infoNode.style.cssText = 'padding: 8px 12px; font-weight: 600; font-size: 0.9rem;';
            infoNode.innerText = `Trang ${currentPage} / ${totalPages}`;
            container.appendChild(infoNode);

            const nextNode = document.createElement('button');
            nextNode.innerText = '❯';
            nextNode.className = 'action-btn';
            nextNode.disabled = currentPage === totalPages;
            nextNode.style.fontWeight = '700';
            nextNode.onclick = () => onPageChange(currentPage + 1);
            container.appendChild(nextNode);
        }

        async function loadExpoCatalog() {
            const r = await fetchExpo('/admin/api/products');
            if (r && r.success) {
                const tbody = document.querySelector('#productsTable tbody');
                tbody.innerHTML = r.data.map(p => `
                    <tr>
                        <td>
                            <div class="product-preview">
                                <img src="${p.description?.images?.[0] || 'https://placehold.co/100?text=Agri'}" class="product-img">
                                <div class="product-title">${p.name}</div>
                            </div>
                        </td>
                        <td><span class="booth-pill" style="background:#f1f5f9;">${p.businessField}</span></td>
                        <td style="font-weight: 700;">${p.pricing?.baseCost?.toLocaleString()} ₫</td>
                        <td style="color: var(--primary); font-weight: 800;">${p.vouchers?.length > 0 ? p.vouchers[0].code : '---'}</td>
                        <td><button class="action-btn" onclick="openProductModal('${p._id}')">✏️</button> <button class="action-btn" onclick="delExpo('products', '${p._id}')">🗑️</button></td>
                    </tr>
                `).join('');
            }
        }

        async function loadExpoVouchers() {
            const r = await fetchExpo('/admin/api/vouchers');
            if (r && r.success) {
                const tbody = document.querySelector('#vouchersTable tbody');
                tbody.innerHTML = r.data.map(v => `
                    <tr>
                        <td><code style="font-weight: 800; background: #fdf2f8; padding: 4px 8px; border-radius: 6px; color: #be185d;">${v.code}</code></td>
                        <td style="font-weight: 700;">${v.name}</td>
                        <td style="color: var(--accent); font-weight: 800;">${v.discountType === 'percentage' ? '-' + v.discountValue + '%' : '-' + v.discountValue.toLocaleString() + ' ₫'}</td>
                        <td style="font-size: 0.8rem;">${v.validUntil ? new Date(v.validUntil).toLocaleDateString('vi-VN') : 'Mãi mãi'}</td>
                        <td style="font-weight: 700;">${v.usageCount || 0} lần</td>
                        <td><button class="action-btn" onclick="openVoucherModal('${v._id}')">✏️</button> <button class="action-btn" onclick="delExpo('vouchers', '${v._id}')">🗑️</button></td>
                    </tr>
                `).join('');
            }
        }

        let currID = null;
        function openMod(id, s) { currID = id; document.getElementById('statusSelect').value = s; document.getElementById('statusOverlay').style.display = 'flex'; }
        function closeStatusModal() { document.getElementById('statusOverlay').style.display = 'none'; }
        async function updateStatus() {
            const s = document.getElementById('statusSelect').value;
            const r = await fetchExpo(`/admin/api/orders/${currID}/status`, 'PUT', { status: s });
            if (r && r.success) { notify('Đã cập nhật lộ trình giao dịch!'); closeStatusModal(); loadAllTransactions(); }
        }

        async function delExpo(t, id) { if (!confirm('Expo Monitor: Xóa dữ liệu này?')) return; const r = await fetchExpo(`/admin/api/${t}/${id}`, 'DELETE'); if (r && r.success) { notify('Dữ liệu đã được gỡ khỏi hệ thống.'); loadData(target); } }

        let currOrderObj = null;
        let allBusinessOwners = [];

        async function fetchOwners() {
            const r = await fetchExpo('/admin/api/business-owners');
            if (r && r.success) {
                allBusinessOwners = r.data;
                const select = document.getElementById('pOwner');
                select.innerHTML = '<option value="">-- Chọn doanh nghiệp --</option>' + 
                    r.data.map(owner => `<option value="${owner._id}">${owner.businessName} (${owner.name})</option>`).join('');
            }
        }

        // --- Order Modal ---
        async function viewOrder(id) {
            const r = await fetchExpo(`/admin/api/orders/${id}`);
            if (r && r.success) {
                const o = r.data;
                currOrderObj = o;
                document.getElementById('dtOrderNo').innerText = o.orderNumber || 'EXPO-' + o._id.slice(-6).toUpperCase();
                document.getElementById('dtCustName').innerText = o.customerName;
                document.getElementById('dtCustPhone').innerText = o.customerPhone;
                document.getElementById('dtCustEmail').innerText = o.customerEmail;
                document.getElementById('dtAddress').innerText = o.address;
                document.getElementById('dtRegion').innerText = `${o.district}, ${o.city}`;
                document.getElementById('dtNotes').innerText = o.notes || 'Không có';
                
                document.getElementById('dtProduct').innerText = o.product?.name || '---';
                document.getElementById('dtOwner').innerText = o.businessOwner?.businessName || '---';
                document.getElementById('dtQty').innerText = o.quantity + 'x';
                document.getElementById('dtPrice').innerText = o.price.toLocaleString() + ' ₫';
                
                document.getElementById('dtTotal').innerText = o.totalPrice.toLocaleString() + ' ₫';
                document.getElementById('dtVoucherCode').innerText = o.voucherCode || 'Không';
                document.getElementById('dtDiscount').innerText = '-' + o.discount.toLocaleString() + ' ₫';
                document.getElementById('dtFinal').innerText = o.finalPrice.toLocaleString() + ' ₫';

                document.getElementById('orderDetailOverlay').style.display = 'flex';
            }
        }

        // --- Product Modal ---
        window.allProductsData = [];
        async function loadExpoCatalog() {
            const r = await fetchExpo('/admin/api/products');
            if (r && r.success) {
                window.allProductsData = r.data;
                const tbody = document.querySelector('#productsTable tbody');
                tbody.innerHTML = r.data.map(p => `
                    <tr>
                        <td>
                            <div class="product-preview">
                                <img src="${p.description?.images?.[0] || 'https://placehold.co/100?text=Agri'}" class="product-img">
                                <div class="product-title">${p.name}</div>
                            </div>
                        </td>
                        <td><span class="booth-pill" style="background:#f1f5f9;">${p.businessField}</span></td>
                        <td style="font-weight: 700;">${p.pricing?.baseCost?.toLocaleString() || 0} ₫</td>
                        <td style="color: var(--primary); font-weight: 800;">Còn: ${p.pricing?.stock ?? '∞'}</td>
                        <td>
                            <button class="action-btn" onclick="openProductModal('${p._id}')">✏️</button>
                            <button class="action-btn" onclick="delExpo('products', '${p._id}')">🗑️</button>
                        </td>
                    </tr>
                `).join('');
            }
        }

        function openProductModal(id = null) {
            document.getElementById('productForm').reset();
            if (allBusinessOwners.length === 0) fetchOwners();
            
            if (id) {
                const p = window.allProductsData.find(x => x._id === id);
                if (p) {
                    document.getElementById('productModalTitle').innerText = 'Chỉnh sửa Sản phẩm';
                    document.getElementById('productId').value = p._id;
                    document.getElementById('pName').value = p.name;
                    document.getElementById('pOwner').value = p.businessOwnerId._id;
                    document.getElementById('pType').value = p.type;
                    document.getElementById('pField').value = p.businessField;
                    document.getElementById('pPrice').value = p.pricing?.baseCost || 0;
                    document.getElementById('pStock').value = p.pricing?.stock !== undefined ? p.pricing.stock : '';
                    document.getElementById('pDesc').value = p.description?.general || '';
                    document.getElementById('pImg').value = p.description?.images?.[0] || '';
                }
            } else {
                document.getElementById('productModalTitle').innerText = 'Thêm Sản phẩm';
                document.getElementById('productId').value = '';
            }
            document.getElementById('productOverlay').style.display = 'flex';
        }

        async function saveProduct(e) {
            e.preventDefault();
            const id = document.getElementById('productId').value;
            const payload = {
                name: document.getElementById('pName').value,
                businessOwnerId: document.getElementById('pOwner').value,
                type: document.getElementById('pType').value,
                businessField: document.getElementById('pField').value,
                pricing: {
                    baseCost: document.getElementById('pPrice').value,
                    stock: document.getElementById('pStock').value ? parseInt(document.getElementById('pStock').value) : null
                },
                description: {
                    general: document.getElementById('pDesc').value,
                    images: document.getElementById('pImg').value ? [document.getElementById('pImg').value] : []
                }
            };

            const method = id ? 'PUT' : 'POST';
            const url = id ? `/admin/api/products/${id}` : '/admin/api/products';
            const r = await fetchExpo(url, method, payload);
            if (r && r.success) {
                notify(id ? 'Cập nhật thành công!' : 'Đã thêm sản phẩm mới!');
                closeModal('productOverlay');
                loadExpoCatalog();
            }
        }

        // --- Voucher Modal ---
        window.allVouchersData = [];
        async function loadExpoVouchers() {
            const r = await fetchExpo('/admin/api/vouchers');
            if (r && r.success) {
                window.allVouchersData = r.data;
                const tbody = document.querySelector('#vouchersTable tbody');
                tbody.innerHTML = r.data.map(v => `
                    <tr>
                        <td><code style="font-weight: 800; background: #fdf2f8; padding: 4px 8px; border-radius: 6px; color: #be185d;">${v.code}</code></td>
                        <td style="font-weight: 700;">${v.name}</td>
                        <td style="color: var(--accent); font-weight: 800;">${v.discountType === 'percentage' ? '-' + v.discountValue + '%' : '-' + v.discountValue.toLocaleString() + ' ₫'}</td>
                        <td style="font-size: 0.8rem;">${v.validUntil ? new Date(v.validUntil).toLocaleDateString('vi-VN') : 'Mãi mãi'}</td>
                        <td style="font-weight: 700;">${v.usageCount || 0} lần</td>
                        <td>
                            <button class="action-btn" onclick="openVoucherModal('${v._id}')">✏️</button> 
                            <button class="action-btn" onclick="delExpo('vouchers', '${v._id}')">🗑️</button>
                        </td>
                    </tr>
                `).join('');
            }
        }

        function openVoucherModal(id = null) {
            document.getElementById('voucherForm').reset();
            if (id) {
                const v = window.allVouchersData.find(x => x._id === id);
                if (v) {
                    document.getElementById('voucherModalTitle').innerText = 'Chỉnh sửa Voucher';
                    document.getElementById('voucherId').value = v._id;
                    document.getElementById('vCode').value = v.code;
                    document.getElementById('vName').value = v.name;
                    document.getElementById('vType').value = v.discountType;
                    document.getElementById('vValue').value = v.discountValue;
                    document.getElementById('vMin').value = v.minimumOrder || 0;
                    document.getElementById('vLimit').value = v.usageLimit || '';
                }
            } else {
                document.getElementById('voucherModalTitle').innerText = 'Tạo Voucher mới';
                document.getElementById('voucherId').value = '';
            }
            document.getElementById('voucherOverlay').style.display = 'flex';
        }

        async function saveVoucher(e) {
            e.preventDefault();
            const id = document.getElementById('voucherId').value;
            const limit = document.getElementById('vLimit').value;
            const payload = {
                code: document.getElementById('vCode').value.toUpperCase(),
                name: document.getElementById('vName').value,
                discountType: document.getElementById('vType').value,
                discountValue: document.getElementById('vValue').value,
                minimumOrder: document.getElementById('vMin').value || 0
            };
            if (limit) payload.usageLimit = parseInt(limit);

            const method = id ? 'PUT' : 'POST';
            const url = id ? `/admin/api/vouchers/${id}` : '/admin/api/vouchers';
            const r = await fetchExpo(url, method, payload);
            if (r && r.success) {
                notify(id ? 'Voucher đã cập nhật!' : 'Voucher mới đã sẵn sàng!');
                closeModal('voucherOverlay');
                loadExpoVouchers();
            } else if (r && !r.success) {
                alert(r.message || 'Lỗi khi lưu voucher');
            }
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        function translate(s) {
            const m = { pending: 'Chờ chốt đơn', confirmed: 'Đã xác nhận', processing: 'Đang chuẩn bị', shipped: 'Đang giao', delivered: 'Đã bàn giao', cancelled: 'Đã hủy' };
            return m[s] || s;
        }

        document.getElementById('logoutBtn').addEventListener('click', () => { localStorage.removeItem('adminToken'); window.location.href = '/admin/login'; });

        fetchOwners(); // Preload owners
        loadData('overview');
    </script>
</body>

</html>