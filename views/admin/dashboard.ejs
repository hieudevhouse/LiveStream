        async function delExpo(t, id) {
            const result = await Swal.fire({
                title: 'Xác nhận xóa?',
                text: "Dữ liệu này sẽ được gỡ khỏi hệ thống và không thể khôi phục!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#15803d',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            });

            if (result.isConfirmed) {
                const r = await fetchExpo(`/admin/api/${t}/${id}`, 'DELETE');
                if (r && r.success) {
                    notify('Dữ liệu đã được gỡ khỏi hệ thống.');
                    const activeMenu = document.querySelector('.menu-link.active').dataset.target;
                    loadData(activeMenu);
                }
            }
