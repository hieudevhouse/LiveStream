<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trung tâm Điều hành Hội chợ Nông sản | Dreamax Expo</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap"
        rel="stylesheet">
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --primary: #15803d;
            /* Forest Green */
            --primary-light: #22c55e;
            --accent: #f97316;
            /* Event Orange */
            --sidebar-bg: #1e293b;
            --main-bg: #fdfcf9;
            /* Off-white eggshell */
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --sidebar-width: 280px;
            --radius: 16px;
            --shadow: 0 10px 30px rgba(21, 128, 61, 0.05);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Lexend', sans-serif;
            background: var(--main-bg);
            color: var(--text-main);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar - Expo Concept */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            color: #f1f5f9;
            display: flex;
            flex-direction: column;
            border-right: 4px solid var(--primary);
        }

        .sidebar-brand {
            padding: 40px 24px;
            text-align: center;
        }

        .brand-box {
            background: white;
            color: var(--primary);
            padding: 12px;
            border-radius: var(--radius);
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            border-bottom: 4px solid var(--accent);
        }

        .brand-box sub {
            font-size: 0.6rem;
            font-family: 'Lexend', sans-serif;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .sidebar-menu {
            flex: 1;
            padding: 20px 16px;
            list-style: none;
        }

        .menu-item {
            margin-bottom: 12px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px 20px;
            border-radius: 12px;
            color: #94a3b8;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: 0.3s;
            cursor: pointer;
        }

        .menu-link:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
        }

        .menu-link.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 8px 16px rgba(21, 128, 61, 0.2);
        }

        .sidebar-footer {
            padding: 24px;
            background: rgba(0, 0, 0, 0.1);
        }

        .user-block {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--accent);
            border: 2px solid white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: white;
        }

        .btn-logout {
            width: 100%;
            padding: 10px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: transparent;
            color: #ef4444;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
            font-weight: 600;
        }

        .btn-logout:hover {
            background: #ef4444;
            color: white;
        }

        /* Main Hub */
        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background-image: radial-gradient(#15803d10 1px, transparent 1px);
            background-size: 20px 20px;
        }

        .top-nav {
            height: 80px;
            padding: 0 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
        }

        .expo-info {
            border-left: 4px solid var(--accent);
            padding-left: 16px;
        }

        .expo-info h4 {
            font-size: 1.1rem;
            color: var(--secondary);
            font-weight: 800;
        }

        .expo-info p {
            font-size: 0.8rem;
            color: var(--accent);
            font-weight: 600;
            text-transform: uppercase;
        }

        .search-expo {
            position: relative;
            width: 350px;
        }

        .search-expo input {
            width: 100%;
            padding: 12px 16px 12px 40px;
            border-radius: 99px;
            border: 1px solid var(--border);
            background: white;
            outline: none;
        }

        .search-expo::before {
            content: '🔍';
            position: absolute;
            left: 14px;
            top: 12px;
            opacity: 0.5;
        }

        .content {
            padding: 40px;
            overflow-y: auto;
            flex: 1;
        }

        /* Expo Hub Cards */
        .hub-header {
            margin-bottom: 32px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .hub-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            color: var(--primary);
        }

        .status-overview {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-bottom: 40px;
        }

        .status-card {
            background: white;
            padding: 24px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            transition: 0.3s;
        }

        .status-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary);
        }

        .status-card .label {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-card .label::before {
            content: '';
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
        }

        .status-card .value {
            font-size: 2rem;
            font-weight: 800;
            color: var(--primary);
        }

        /* Table & Lists as Expo Booths */
        .expo-container {
            background: white;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 30px;
        }

        .expo-header {
            padding: 24px 30px;
            background: #fafafa;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .expo-header h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
        }

        .expo-table {
            width: 100%;
            border-collapse: collapse;
        }

        .expo-table th {
            text-align: left;
            padding: 16px 30px;
            background: white;
            font-size: 0.75rem;
            font-weight: 800;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .expo-table td {
            padding: 20px 30px;
            border-bottom: 1px solid #f8f8f8;
            font-size: 0.9rem;
        }

        .expo-table tr:hover td {
            background: #fdfdfd;
        }

        .booth-pill {
            padding: 6px 12px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 0.7rem;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .bg-pending {
            background: #fff7ed;
            color: #ea580c;
            border: 1px solid #ffedd5;
        }

        .bg-confirmed {
            background: #f0fdf4;
            color: #16a34a;
            border: 1px solid #dcfce7;
        }

        .bg-shipped {
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #dbeafe;
        }

        .bg-cancelled {
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fee2e2;
        }

        .product-preview {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .product-img {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            object-fit: cover;
            border: 2px solid #f1f5f9;
        }

        .product-title {
            font-weight: 700;
            color: var(--secondary);
            font-size: 0.95rem;
        }

        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: white;
            cursor: pointer;
            transition: 0.2s;
        }

        .action-btn:hover {
            border-color: var(--primary);
            color: var(--primary);
            transform: scale(1.1);
        }

        .btn-fair {
            padding: 12px 24px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 4px 12px rgba(21, 128, 61, 0.2);
        }

        .btn-fair:hover {
            background: var(--primary-light);
            transform: translateY(-2px);
        }

        /* Modals & Views */
        .view-section {
            display: none;
        }

        .view-section.active {
            display: block;
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .modal {
            background: white;
            border-radius: 20px;
            width: 450px;
            padding: 32px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
            border: 2px solid var(--primary);
        }

        .toast-box {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 3000;
        }

        .toast {
            background: var(--primary);
            color: white;
            padding: 16px 24px;
            border-radius: 12px;
            font-weight: 700;
            box-shadow: 10px 10px 30px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from {
                transform: translateY(100%);
            }

            to {
                transform: translateY(0);
            }
        }

        select,
        .form-input {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            outline: none;
            border: 1px solid var(--border);
            background: #f8fafc;
            font-weight: 500;
            font-family: inherit;
        }

        .form-input:focus,
        select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.1);
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .modal-lg {
            width: 700px;
            max-width: 95%;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-header-nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 16px;
        }

        .modal-header-nav h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--primary);
        }

        .close-btn {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #94a3b8;
        }

        .close-btn:hover {
            color: #ef4444;
        }

        /* Order Details Styles */
        .order-detail-card {
            background: #f8fafc;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
        }

        .order-detail-header {
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 12px;
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        .detail-row span:first-child {
            color: var(--text-muted);
        }

        .detail-row span:last-child {
            font-weight: 600;
            text-align: right;
        }
    </style>
</head>

<body>

    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-box">
                DREAMAX<sub>Expo 2026</sub>
            </div>
        </div>

        <ul class="sidebar-menu">
            <li class="menu-item"><a class="menu-link active" data-target="overview">🏛️ Sảnh Điều hành</a></li>
            <li class="menu-item"><a class="menu-link" data-target="orders">💳 Giao dịch Hội chợ</a></li>
            <li class="menu-item"><a class="menu-link" data-target="products">🧺 Danh mục Gian hàng</a></li>
            <li class="menu-item"><a class="menu-link" data-target="vouchers">🧧 Mã Ưu đãi Đặc biệt</a></li>
            <li class="menu-item"><a class="menu-link" data-target="gifts">🎁 Quản lý Quà tặng</a></li>
        </ul>

        <div class="sidebar-footer">
            <div class="user-block">
                <div class="user-avatar" id="avatarLetter">A</div>
                <div>
                    <div style="font-weight:700; font-size: 0.9rem;" id="adminMailLabel">Admin Expo</div>
                    <div style="font-size: 0.75rem; color: #94a3b8;">Ban Tổ Chức</div>
                </div>
            </div>
            <button class="btn-logout" id="logoutBtn">Kết thúc ca trực</button>
        </div>
    </aside>

    <main class="main">
        <nav class="top-nav">
            <div class="expo-info">
                <h4>Hội chợ Nông sản 2026</h4>
                <p>Trung tâm Triển lãm Thành phố</p>
            </div>

            <div class="search-expo">
                <input type="text" placeholder="Tìm gian hàng, sản phẩm, khách mời...">
            </div>

            <div style="display: flex; gap: 12px;">
                <button class="btn-fair" onclick="window.open('/products', '_blank')">🌐 Trang chủ Hội chợ</button>
            </div>
        </nav>

        <section class="content">

            <!-- OVERVIEW HUB -->
            <div id="overviewView" class="view-section active">
                <div class="hub-header">
                    <div>
                        <h2>Xin chào, <span id="adminName">Admin</span>!</h2>
                        <p style="color: var(--text-muted);">Chào mừng bạn trở lại Trung tâm Điều hành số Hội chợ Nông
                            sản.</p>
                    </div>
                </div>

                <div class="status-overview">
                    <div class="status-card">
                        <div class="label">Tổng giao dịch</div>
                        <div class="value" id="statOrders">0</div>
                    </div>
                    <div class="status-card">
                        <div class="label">Sản phẩm trưng bày</div>
                        <div class="value" id="statProducts">0</div>
                    </div>
                    <div class="status-card">
                        <div class="label">Doanh thu dự kiến</div>
                        <div class="value" id="statRevenue">0</div>
                    </div>
                    <div class="status-card">
                        <div class="label">Chiến dịch Ưu đãi</div>
                        <div class="value" id="statVouchers">0</div>
                    </div>
                </div>

                <div class="expo-container"
                    style="background: transparent; padding: 0; box-shadow: none; margin-top: 24px;">
                    <!-- Row 1: Revenue & Status -->
                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 24px;">
                        <div
                            style="background: white; border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow); border: 1px solid var(--border);">
                            <div
                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                                <h3 style="color: var(--secondary); display: flex; align-items: center; gap: 10px;">📈
                                    Doanh thu Hôm nay (Theo giờ)</h3>
                                <div
                                    style="font-size: 0.85rem; color: var(--text-muted); padding: 4px 12px; background: #f0fdf4; border-radius: 99px; color: var(--primary); font-weight: 700;">
                                    Live Update</div>
                            </div>
                            <div style="height: 300px;">
                                <canvas id="revenueChart"></canvas>
                            </div>
                        </div>
                        <div
                            style="background: white; border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow); border: 1px solid var(--border);">
                            <h3
                                style="margin-bottom: 24px; color: var(--secondary); display: flex; align-items: center; gap: 10px;">
                                📊 Trạng thái Đơn hàng</h3>
                            <div style="height: 300px; display: flex; align-items: center; justify-content: center;">
                                <canvas id="statusChart"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Top Products & Gift Ratio -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
                        <div
                            style="background: white; border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow); border: 1px solid var(--border);">
                            <h3
                                style="margin-bottom: 24px; color: var(--secondary); display: flex; align-items: center; gap: 10px;">
                                🏆 Top 5 Sản phẩm Bán chạy</h3>
                            <div style="height: 300px;">
                                <canvas id="topProductsChart"></canvas>
                            </div>
                        </div>
                        <div
                            style="background: white; border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow); border: 1px solid var(--border);">
                            <h3
                                style="margin-bottom: 24px; color: var(--secondary); display: flex; align-items: center; gap: 10px;">
                                💎 Đại gia mua sắm (Hôm nay)</h3>
                            <div id="topBuyersList" style="display: flex; flex-direction: column; gap: 16px;">
                                <!-- Dữ liệu từ JS -->
                                <div style="text-align: center; color: var(--text-muted); padding: 50px;">Đang tính toán
                                    dữ liệu khách hàng...</div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 3: Gift Ratio & Other Info -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
                        <div
                            style="background: white; border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow); border: 1px solid var(--border);">
                            <h3
                                style="margin-bottom: 24px; color: var(--secondary); display: flex; align-items: center; gap: 10px;">
                                🎁 Tỉ lệ Quà tặng / Sản phẩm</h3>
                            <div style="height: 250px; display: flex; align-items: center; justify-content: center;">
                                <canvas id="ratioChart"></canvas>
                            </div>
                        </div>
                        <div
                            style="background: var(--primary); color: white; border-radius: var(--radius); padding: 40px; display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden;">
                            <h2 style="font-size: 2rem; margin-bottom: 15px; position: relative; z-index: 1;">Dreamax
                                Expo 2026</h2>
                            <p style="opacity: 0.9; position: relative; z-index: 1;">Kỹ thuật số hóa ngành nông nghiệp
                                Việt Nam vươn tầm thế giới.</p>
                            <div
                                style="position: absolute; right: -20px; bottom: -20px; font-size: 8rem; opacity: 0.1;">
                                🎋</div>
                        </div>
                    </div>

                    <!-- Row 4: Recent Transactions (Restored & Improved) -->
                    <div
                        style="background: white; border-radius: var(--radius); padding: 30px; box-shadow: var(--shadow); border: 1px solid var(--border);">
                        <div
                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
                            <h3 style="color: var(--secondary); display: flex; align-items: center; gap: 10px;">🕒 Giao
                                dịch Gần nhất</h3>

                            <div
                                style="display: flex; gap: 12px; align-items: center; flex: 1; min-width: 300px; justify-content: flex-end;">
                                <div style="position: relative; flex: 1; max-width: 400px;">
                                    <input type="text" id="recentSearchInput" onkeyup="searchRecentOrders()"
                                        placeholder="Tìm tên, SĐT, hoặc mặt hàng..."
                                        style="width: 100%; padding: 10px 15px 10px 40px; border: 1px solid var(--border); border-radius: 10px; font-size: 0.9rem;">
                                    <span style="position: absolute; left: 15px; top: 10px; opacity: 0.5;">🔍</span>
                                </div>

                                <select id="recentStatusFilter" onchange="filterRecentOrders()"
                                    style="padding: 10px 12px; font-size: 0.85rem; border: 1px solid var(--border); border-radius: 10px;">
                                    <option value="">Trạng thái: Tất cả</option>
                                    <option value="pending">Chờ chốt</option>
                                    <option value="confirmed">Xác nhận</option>
                                    <option value="processing">Chuẩn bị</option>
                                    <option value="shipped">Đang giao</option>
                                    <option value="delivered">Bàn giao</option>
                                    <option value="cancelled">Đã hủy</option>
                                </select>

                                <button class="action-btn" onclick="loadAllTransactions()"
                                    style="background: var(--primary); color: white; padding: 10px 15px; border-radius: 10px;">🔄</button>
                            </div>
                        </div>
                        <div style="overflow-x: auto;">
                            <table class="expo-table" id="recentOrdersTable">
                                <thead>
                                    <tr>
                                        <th>Khách hàng & SĐT</th>
                                        <th>Sản phẩm / Quà tặng</th>
